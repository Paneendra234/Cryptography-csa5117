key = "MONARCHY"
matrix = [
    ['M','O','N','A','R'],
    ['C','H','Y','B','D'],
    ['E','F','G','I','K'],
    ['L','P','Q','S','T'],
    ['U','V','W','X','Z']
]

text = input("Enter two letters: ").upper()

a, b = text[0], text[1]

for i in range(5):
    for j in range(5):
        if matrix[i][j] == a:
            r1, c1 = i, j
        if matrix[i][j] == b:
            r2, c2 = i, j

if r1 == r2:
    print(matrix[r1][(c1+1)%5] + matrix[r2][(c2+1)%5])
elif c1 == c2:
    print(matrix[(r1+1)%5][c1] + matrix[(r2+1)%5][c2])
else:
    print(matrix[r1][c2] + matrix[r2][c1])
